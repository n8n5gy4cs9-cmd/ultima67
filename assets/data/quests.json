[
 {
  "id": "m01_hum_of_the_gate",
  "title": "The Hum of the Gate",
  "desc": "A Bifrost gate near Kaupang has begun to hum, and the dead are walking out of it.",
  "category": "main",
  "steps": [
   {
    "text": "Speak to Eirikr the Skald in the Kaupang tavern.",
    "when": {
     "is": "flag",
     "flag": "talked_eirikr"
    }
   },
   {
    "text": "Stock up: carry at least 60 rounds of 9mm (Brokk Jr. sells them at the forge).",
    "when": {
     "is": "has_item",
     "item": "ammo_9mm",
     "count": 60
    }
   },
   {
    "text": "Investigate the humming Bifrost gate north of Kaupang.",
    "when": {
     "is": "flag",
     "flag": "at_midgard_kaupang_gate"
    }
   },
   {
    "text": "Destroy the draugr crawling out of the gate (3).",
    "when": {
     "is": "counter",
     "counter": "kills_draugr",
     "min": 3
    }
   }
  ],
  "reward": [
   {
    "op": "xp",
    "amount": 150
   },
   {
    "op": "give",
    "item": "medkit",
    "count": 2
   },
   {
    "op": "money",
    "amount": 100
   },
   {
    "op": "set_flag",
    "flag": "gate_secured"
   },
   {
    "op": "toast",
    "text": "The gate falls quiet... for now."
   }
  ],
  "start_when": {
   "is": "flag",
   "flag": "game_started"
  }
 },
 {
  "id": "m02_warband",
