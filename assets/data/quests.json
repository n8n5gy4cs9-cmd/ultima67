    "item": "round_shield",
    "count": 1
   }
  ],
  "start_when": {
   "is": "quest",
   "quest": "m01_hum_of_the_gate",
   "state": "done"
  }
 },
 {
  "id": "m03_three_threads",
  "title": "The Three Threads",
  "desc": "Urðr, Verðandi and Skuld spun three threads. They lie in Midgård's barrows and Mimir's Well.",
  "category": "main",
  "steps": [
   {
    "text": "Drink at Mimir's Well in the heart of Midgård.",
    "when": {
     "is": "flag",
     "flag": "at_midgard_mimir_well"
    }
   },
   {
    "text": "Defeat the Barrow King of the western barrow (Verðandi's thread).",
    "when": {
     "is": "flag",
     "flag": "at_barrow_2_boss"
    }
   },
   {
    "text": "Defeat the Barrow King of the eastern barrow (Skuld's thread).",
    "when": {
     "is": "flag",
     "flag": "at_barrow_1_boss"
    }
   },
   {
    "text": "Slay the Barrow King (kill count 2).",
    "when": {
     "is": "counter",
     "counter": "kills_barrow_king",
     "min": 2
    }
   }
  ],
  "reward": [
   {
    "op": "xp",
    "amount": 350
   },
   {
    "op": "give",
    "item": "thor_amulet",
    "count": 1
   },
   {
    "op": "unlock_travel",
    "node": "midgard"
   }
  ],
  "start_when": {
   "is": "quest",
   "quest": "m02_warband",
   "state": "done"
  }
 },
